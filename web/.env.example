# Daabi - Environment Variables Template
# Copy this file to .env.local and fill in your values

# ===========================================
# DATABASE
# ===========================================
# PostgreSQL connection string
# For Docker: postgresql://daabi_user:daabi_password@localhost:5433/daabi_db
DATABASE_URL="postgresql://daabi_user:daabi_password@localhost:5433/daabi_db"

# ===========================================
# APPLICATION
# ===========================================
# Next.js URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node environment
NODE_ENV="development"

# ===========================================
# AUTHENTICATION (optional for advanced features)
# ===========================================
# JWT Secret for token signing (generate a random 32+ character string)
# JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Session secret
# SESSION_SECRET="your-session-secret-change-this"

# ===========================================
# FILE UPLOADS (optional - for future implementation)
# ===========================================
# Cloudinary settings for image/video uploads
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Or use AWS S3
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""
# AWS_REGION=""

# ===========================================
# EMAIL (optional - for verification emails)
# ===========================================
# SMTP settings
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM=""

# ===========================================
# PAYMENT GATEWAY (optional - for crowdfunding)
# ===========================================
# bKash/Nagad integration
# BKASH_APP_KEY=""
# BKASH_APP_SECRET=""
# BKASH_USERNAME=""
# BKASH_PASSWORD=""

# Stripe (alternative payment)
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
